# PostgreSQL (Base métier La Gazette + Base Airflow)
POSTGRES_USER=gazette
POSTGRES_PASSWORD=gazette_secret
POSTGRES_DB=gazette
AIRFLOW_DB_PASSWORD=airflow_secret

# Permissions Airflow (Linux/WSL)
AIRFLOW_UID=50000

# Chemins de stockage dans le conteneur pipeline
RAW_DATA_DIR=/app/data/raw
OUTPUT_DIR=/app/data/editions